{
  "rewrites": [
    {
      "source": "/u/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|SkypeUriPreview|redditbot|Pinterest|vkShare|W3C_Validator).*"
        }
      ],
      "destination": "/api/og?type=u&slug=:slug"
    },
    {
      "source": "/p/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|SkypeUriPreview|redditbot|Pinterest|vkShare|W3C_Validator).*"
        }
      ],
      "destination": "/api/og?type=p&slug=:slug"
    },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
